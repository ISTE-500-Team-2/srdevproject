# Copy to .env.local at the repository root (ignored by git).
# Optional backend integrations for npm run dev and npm run dev:email.
# Email settings below are used only by npm run dev:email.
BREVO_API_KEY=
EMAIL_FROM=arborcollaboratory@yahoo.com
EMAIL_REPLY_TO=arborcollaboratory@yahoo.com
EMAIL_FROM_NAME=The Crafty Studio
EMAIL_POSTAL_ADDRESS=1449 Wiseburg Road, White Hall, Maryland 21161
EMAIL_WORKER_INTERVAL_MS=60000
# The launcher controls DB settings, mode, ports and APP_ORIGIN automatically.
# Never prefix a secret with VITE_; the frontend must not receive this file.

# Optional Stripe test checkout for equipment, memberships, passes and studios.
# Get whsec_ from: stripe listen --forward-to localhost:8080/api/webhooks/stripe-studios
STRIPE_TEST_SECRET_KEY=
STRIPE_STUDIO_WEBHOOK_SECRET=
