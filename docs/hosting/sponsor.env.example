# Copy to .env.sponsor at the repository root. Never commit the real file.
# A hostname only: no https://, slash, or path.
PUBLIC_HOST=members.your-studio.example
TLS_EMAIL=owner@your-studio.example
# A unique label for this installed version, e.g. handoff-01. Record its Git SHA.
ARBOR_VERSION=handoff-01
APP_TIME_ZONE=America/New_York
STUDIO_CONTACT_EMAIL=owner@your-studio.example
STUDIO_CONTACT_PHONE=
# Leave false for the initial technical health check. Configure Brevo and turn
# true BEFORE inviting anyone: signup requires a delivered confirmation email.
EMAIL_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM=owner@your-studio.example
EMAIL_REPLY_TO=owner@your-studio.example
EMAIL_FROM_NAME=The Crafty Studio
EMAIL_POSTAL_ADDRESS=REPLACE_WITH_APPROVED_BUSINESS_POSTAL_ADDRESS
EMAIL_WORKER_INTERVAL_MS=60000
# Optional provider delivery-event callback; generate a separate 32+ char token.
BREVO_WEBHOOK_TOKEN=
# Blank disables Stripe. Only test keys are supported by this release.
STRIPE_TEST_SECRET_KEY=
STRIPE_STUDIO_WEBHOOK_SECRET=
# Blank disables physical reader authentication. Setup is a separate handoff.
ACCESS_CARD_HASH_KEY=
ACCESS_READERS_JSON=
