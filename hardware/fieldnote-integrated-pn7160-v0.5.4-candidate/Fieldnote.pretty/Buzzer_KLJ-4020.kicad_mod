(footprint "Buzzer_KLJ-4020"
	(version 20240108)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Keliking KLJ-4020 4x4x2 mm SMD magnetic transducer (LCSC C556936), externally driven, 12 ohm coil. Pads from the Keliking spec 3.1 recommended land pattern: 0.9 x 1.8 mm, 0.2 mm outside the 4.0 mm body -> centres at x +-1.75. Pad 1 = + per that drawing (PCB top view); the part's top-view + mark is drawn on the other side in the same datasheet, so confirm polarity on the first boards (reversed polarity lowers output, it does not stop it). FUET-4020 (C391027) uses the same 4.4 x 1.8 land pattern. Sound port on a side face. 3D model is a scaled Murata piezo stand-in.")
	(tags "buzzer magnetic transducer SMD 4x4")
	(attr smd)
	(property "Reference" "REF**" (at 0 -3.0 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
	(property "Value" "Buzzer_KLJ-4020" (at 0 3.0 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(fp_rect (start -2 -2) (end 2 2) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_line (start -2.1 -2.12) (end 2.1 -2.12) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -2.1 2.12) (end 2.1 2.12) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -2.05 -1.5) (end -1.45 -1.5) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -1.75 -1.8) (end -1.75 -1.2) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_rect (start -2.45 -2.4) (end 2.45 2.4) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(pad "1" smd rect (at -1.75 0) (size 0.9 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd rect (at 1.75 0) (size 0.9 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
	(model "${KICAD10_3DMODEL_DIR}/Buzzer_Beeper.3dshapes/Buzzer_Murata_PKMCS0909E.step" (offset (xyz 0 0 0)) (scale (xyz 0.4444 0.4444 1.0526)) (rotate (xyz 0 0 0)))
)
