guide/tree/main/skills/figma-generate-design","creator_name":"Figma"},{"name":"/figma-generate-library","description":"Create new components in Figma from a codebase.","url":"https://github.com/figma/mcp-server-guide/tree/main/skills/figma-generate-library","creator_name":"Figma"},{"name":"/figma-use-figjam (required for FigJam)","description":"Create and modify content in FigJam boards, including stickies, sections, connectors, shapes, tables, and code blocks.","url":"https://github.com/figma/mcp-server-guide/tree/main/skills/figma-use-figjam","creator_name":"Figma"},{"name":"/figma-use-slides (required for Figma Slides)","description":"Create and edit presentations in Figma Slides preserving existing styles and layouts.","url":"https://github.com/figma/mcp-server-guide/tree/main/skills/figma-use-slides","creator_name":"Figma"},{"name":"/figma-generate-diagram","description":"Use with the generate_diagram tool to create architecture diagrams, ERDs, flowcharts, and more in FigJam.","url":"https://github.com/figma/mcp-server-guide/tree/main/skills/figma-generate-diagram","creator_name":"Figma"},{"name":"/generate-project-plan","description":"Create a structured project plan in FigJam from a codebase, doc, or prompt.","url":"https://github.com/figma/mcp-server-guide/tree/main/workflow-skills/generate-project-plan","creator_name":"Figma"},{"name":"/prototype-to-figma","description":"Converts a code prototype into multiple static Figma frames with annotated interactions.","url":"https://github.com/alima-max/prototype-to-figma-skill/tree/main","creator_name":"Amy Lima, Figma and TJ Pitre, Southleft"},{"name":"/create-voice","description":"Generates screen reader specs (VoiceOver, TalkBack, ARIA) from Figma components.","url":"https://github.com/redongreen/uSpec","creator_name":"Ian Guisard, Uber"},{"name":"/rad-spacing","description":"Applies hierarchical spacing with variables and fallbacks.","url":"https://github.com/nolanperk/rad-spacing","creator_name":"Nolan Perkins, Rad Collab"},{"name":"/apply-design-system","description":"Connects existing Figma designs to published design system components.","url":"https://github.com/edenspiekermann/Skills/tree/main/skills/apply-design-system","creator_name":"Chris Goebel, Edenspiekermann"},{"name":"/audit-design-system","description":"Audits Figma screens for design-system integration drift.","url":"https://github.com/edenspiekermann/Skills/tree/main/skills/audit-design-system","creator_name":"Chris Goebel, Edenspiekermann"},{"name":"/cc-figma-component","description":"Generate Figma components from a structured JSON contract file.","url":"https://github.com/nvillapiano/component-contracts-figma/tree/main/skills/cc-figma-component","creator_name":"Nick Villapiano, One North"},{"name":"/cc-figma-tokens","description":"Generate Figma tokens from a structured JSON contract file.","url":"https://github.com/nvillapiano/component-contracts-figma/tree/main/skills/cc-figma-tokens","creator_name":"Nick Villapiano, One North"},{"name":"/edit-figma-design","description":"Orchestrates Figma design workflows using Warp and Oz","url":"https://github.com/warpdotdev/figma-skills/tree/main/.agents/.skills/edit-figma-design","creator_name":"Warp"},{"name":"/multi-agent","description":"Run parallel workflows and implement designs in Augment.","url":"https://github.com/AugmentedAJ/skills/tree/main/augment-multi-agent-figma","creator_name":"Augment Code"},{"name":"/sync-figma-token","description":"Sync design tokens between code and Figma variables with drift detection.","url":"https://github.com/firebenders/sync-figma-token-skill/tree/main","creator_name":"Anish Karthik, Firebender"}]},"group":"default","is_device_based":false,"passed":false,"name":"1415917566","rule_id":"default","secondary_exposures":[]},"587526229":{"id_type":"userID","value":{"max_profile_level":100,"max_tree_depth":10},"group":"default","is_device_based":false,"passed":false,"name":"587526229","rule_id":"default","secondary_exposures":[