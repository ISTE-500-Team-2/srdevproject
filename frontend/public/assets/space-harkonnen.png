  /*  PAGE LAYOUT STYLES */
  .fb-page-layout {
    background-color: var(--color-bg, white);
  }

  .fb-flex-row {
    height: 100vh;
    display: flex;
    flex-direction: row;
  }

  .fb-sidebar {
    width: 240px;
    padding-top: 4px;
    display: flex;
    flex-direction: column;
  }

  .fb-sidebar > :nth-last-child(2) {
    opacity: 0.6;
  }

  .fb-sidebar > :nth-last-child(1) {
    opacity: 0.3;
  }

  .fb-page {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    border-left: 1px var(--color-border) solid;
  }

  .fb-page-content-columns {
    overflow: hidden;
    flex-grow: 1;
    display: flex;
