    margin-right: 16px;
    padding-left: 32px;
  }

  .fb-fading-content {
    margin-left: 32px;
  }

  /* This is what applies the fading gradient over the skeletons */
  .fb-fading-content:after {
    position: absolute;
    bottom: 0;
    height: 100%;
    width: 100%;
    content: "";
    background: linear-gradient(to bottom, transparent 50%, var(--color-bg) 100%);
    pointer-events: none;
  }

  /* SIDEBAR STYLES */

