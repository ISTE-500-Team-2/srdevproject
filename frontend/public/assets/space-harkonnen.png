      <script nonce="nWwIjxUmuiXxOgHB5OMQTQ==">
        // We support Chrome 122, Firefox 128, Safari 17.4
        function isSupportedBrowser() {
          // Chrome 111, Safari 16.4, FF 128
          const firefox128 = typeof ArrayBuffer.prototype.resize === "function";

          // Chrome 119, Safari 17.4, FF 121
          const safari17_4 = typeof Promise.withResolvers === "function"

          // Chrome 122, Safari 17, FF 127
          const chrome_122 = typeof Set.prototype.union === "function"


          const checks = [
            firefox128,
            safari17_4,
            chrome_122,
            window.WebGL2RenderingContext !== undefined,
            window.WeakRef !== undefined,
          ]
          // The browser is supported if all checks pass
          return checks.every(v => v)
        }
        if (!isSupportedBrowser()) {
          window.isUnsupportedBrowser = true
          location.href = '/unsupported_browser'
        }
      </script>

      

